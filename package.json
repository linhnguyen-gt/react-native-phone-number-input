{
    "name": "@linhnguyen96114/react-native-phone-input",
    "version": "3.8.0",
    "description": "React Native component for phone number",
    "source": "./src/index.tsx",
    "main": "./lib/commonjs/index.js",
    "module": "./lib/module/index.js",
    "react-native": "./src/index.tsx",
    "typings": "./index.d.ts",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "react-native": "./src/index.tsx",
            "types": "./index.d.ts",
            "import": "./lib/module/index.js",
            "require": "./lib/commonjs/index.js",
            "default": "./lib/module/index.js"
        }
    },
    "files": [
        "src",
        "lib",
        "android",
        "ios",
        "cpp",
        "*.podspec",
        "!.tmp",
        "!lib/typescript/example",
        "!ios/build",
        "!android/build",
        "!android/gradle",
        "!android/gradlew",
        "!android/gradlew.bat",
        "!android/local.properties",
        "!**/__tests__",
        "!**/__fixtures__",
        "!**/__mocks__",
        "!**/.*",
        "index.d.ts"
    ],
    "scripts": {
        "example": "npm run --workspace react-native-phone-number-input-example",
        "test": "jest",
        "typecheck": "tsc",
        "lint": "eslint \"**/*.{js,ts,tsx}\"",
        "lint:fix": "eslint \"**/*.{js,ts,tsx}\" --fix",
        "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
        "prepare": "bob build",
        "release": "release-it",
        "release:major": "release-it major"
    },
    "keywords": [
        "react-native",
        "ios",
        "android"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/linhnguyen-gt/react-native-phone-number-input.git"
    },
    "author": "Linh Nguyen <linhnguyen96114@gmail.com> (https://github.com/linhnguyen-gt/react-native-phone-number-input)",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/linhnguyen-gt/react-native-phone-number-input/issues"
    },
    "homepage": "https://github.com/linhnguyen-gt/react-native-phone-number-input#readme",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@commitlint/config-conventional": "^21.2.2",
        "@evilmartians/lefthook": "^2.0.11",
        "@react-native-community/cli": "20.2.0",
        "@react-native/eslint-config": "0.87.0",
        "@react-native/jest-preset": "0.87.0",
        "@release-it/conventional-changelog": "^12.0.0",
        "@testing-library/jest-native": "^5.4.3",
        "@testing-library/react-native": "^14.0.1",
        "@types/babel__core": "^7",
        "@types/babel__preset-env": "^7",
        "@types/google-libphonenumber": "^7.4.30",
        "@types/jest": "^30.0.0",
        "@types/react": "^19.2.0",
        "@types/react-test-renderer": "^19.1.0",
        "commitlint": "^21.2.2",
        "del-cli": "^7.0.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.0.1",
        "jest": "^30.4.2",
        "prettier": "^3.0.3",
        "react": "19.2.8",
        "react-native": "0.87.0",
        "react-native-builder-bob": "^0.43.0",
        "react-native-safe-area-context": "^5.5.2",
        "react-test-renderer": "19.2.8",
        "release-it": "^21.0.2",
        "test-renderer": "^1.2.0",
        "turbo": "^2.8.20",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "@types/react": "^19.2.0",
        "babel-jest": "^30.4.1",
        "jest-environment-node": "^30.4.1",
        "@jest/create-cache-key-function": "^30.4.1",
        "hermes-parser": "^0.36.1",
        "babel-plugin-syntax-hermes-parser": "^0.36.1",
        "eslint-plugin-ft-flow": "^3.0.11"
    },
    "engines": {
        "node": ">= 22.11.0"
    },
    "peerDependencies": {
        "react": "*",
        "react-native": "*",
        "react-native-safe-area-context": "*"
    },
    "workspaces": [
        "example"
    ],
    "jest": {
        "preset": "@react-native/jest-preset",
        "testMatch": [
            "**/__tests__/**/*.(js|jsx|ts|tsx)",
            "**/*.(test|spec).(js|jsx|ts|tsx)"
        ],
        "modulePathIgnorePatterns": [
            "<rootDir>/example/node_modules",
            "<rootDir>/lib/"
        ],
        "collectCoverageFrom": [
            "src/**/*.{js,jsx,ts,tsx}",
            "!src/**/*.d.ts",
            "!src/**/__tests__/**"
        ],
        "transformIgnorePatterns": [
            "node_modules/(?!(react-native|@react-native|react-native-.*)/)"
        ]
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "release-it": {
        "ci": true,
        "git": {
            "commitMessage": "chore: release ${version}",
            "tagName": "v${version}",
            "requireCleanWorkingDir": true,
            "requireUpstream": false
        },
        "npm": {
            "publish": false
        },
        "github": {
            "release": true,
            "releaseName": "v${version}",
            "autoGenerate": false
        },
        "hooks": {
            "after:bump": "echo 'Version bumped to ${version}'"
        },
        "plugins": {
            "@release-it/conventional-changelog": {
                "preset": "angular",
                "infile": "CHANGELOG.md",
                "header": "# Changelog\n\nAll notable changes to this project will be documented in this file. See [standard-version](https://github.com/conventional-changelog/standard-version) for commit guidelines."
            }
        }
    },
    "prettier": {
        "bracketSameLine": true,
        "bracketSpacing": true,
        "singleQuote": false,
        "trailingComma": "none",
        "semi": true,
        "tabWidth": 4,
        "printWidth": 120
    },
    "react-native-builder-bob": {
        "source": "src",
        "output": "lib",
        "targets": [
            [
                "commonjs",
                {
                    "esm": true
                }
            ],
            [
                "module",
                {
                    "esm": true
                }
            ],
            [
                "typescript",
                {
                    "project": "tsconfig.build.json"
                }
            ]
        ]
    },
    "create-react-native-library": {
        "type": "module-legacy",
        "languages": "kotlin-swift",
        "version": "0.42.2"
    },
    "dependencies": {
        "@callstack/react-theme-provider": "^3.0.9",
        "fuse.js": "^7.0.0",
        "google-libphonenumber": "^3.2.44",
        "node-emoji": "^2.2.0",
        "react-async-hook": "^4.0.0"
    },
    "directories": {
        "example": "example"
    },
    "allowScripts": {
        "@evilmartians/lefthook": true,
        "fsevents": true
    }
}
